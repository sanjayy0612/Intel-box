# LLM -- bring at least one. LLM_PROVIDER forces a choice; otherwise the first
# key present wins, checked Anthropic, then OpenAI, then Groq.
# Without any of these the orchestrator can't choose tools and falls back to
# running all four, which the UI labels plainly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=

# Research tools
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Search. SearXNG won't start while its secret is the upstream placeholder --
# generate one with:  openssl rand -hex 32
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=

# Persistence. IntelBox never talks to MongoDB directly -- every read and write
# goes through an MCP server. MONGODB_URI is read by that server, not by the app.
# deployment/mcp_server/ is a local one that implements IntelBox's tool contract.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=intelbox
MONGODB_MCP_SERVER_URL=http://localhost:8001/mcp
